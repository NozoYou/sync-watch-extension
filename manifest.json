{
    "manifest_version": 3,
    "name": "一起看 · Sync Watch",
    "version": "0.13.0",
    "description": "和朋友的视频同步播放插件。",
    "permissions": [
        "activeTab",
        "storage",
        "tabs",
        "notifications",
        "scripting",
        "offscreen",
        "declarativeNetRequestWithHostAccess"
    ],
    "host_permissions": ["<all_urls>", "https://*/*", "http://*/*"],
    "action": {
        "default_title": "一起看",
        "default_popup": "popup.html"
    },
    "commands": {
        "share-current-page": {
            "suggested_key": {
                "default": "Alt+S",
                "mac": "Option+S"
            },
            "description": "分享当前页面到房间"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "tab-icon.svg",
                "controller/styles/shared.css",
                "controller/styles/style-1/style.css",
                "controller/animations/rotation.css"
            ],
            "matches": ["<all_urls>"]
        }
    ],
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": [
                "controller/core/progress-ring.js",
                "controller/animations/rotation.js",
                "controller/player/skip-segments.js",
                "oped-automation/extension/client.js",
                "controller/player/ad-filter.js",
                "controller/player/comment-filter.js",
                "controller/panels/create-room.js",
                "controller/panels/join-room.js",
                "controller/panels/shared-history.js",
                "controller/panels/local-history.js",
                "controller/styles/style-1/index.js",
                "controller/core/controller-actions.js",
                "controller/core/controller-manager.js",
                "content.js"
            ],
            "run_at": "document_idle",
            "all_frames": true,
            "match_origin_as_fallback": true
        }
    ]
}
