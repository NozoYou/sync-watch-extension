{
    "manifest_version": 3,
    "name": "一起看 · Sync Watch",
    "version": "0.8.0",
    "description": "和最多 4 位朋友同步网页视频播放。",
    "permissions": ["activeTab", "storage", "tabs", "notifications"],
    "host_permissions": ["<all_urls>", "https://*/*", "http://*/*"],
    "action": {
        "default_title": "一起看",
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "run_at": "document_idle",
            "all_frames": true,
            "match_origin_as_fallback": true
        }
    ]
}
